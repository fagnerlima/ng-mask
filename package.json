{
  "name": "ng-mask-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Development workspace for @fagnerlima/ng-mask (library + demo).",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "lint": "ng lint",
    "test": "ng test ng-mask --watch=false && ng test demo --watch=false",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "ng build ng-mask && node scripts/finalize-package.mjs",
    "build:demo": "ng build demo",
    "pack:check": "node scripts/check-package.mjs",
    "test:scripts": "node --test 'scripts/*.test.mjs'"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.5.1",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
